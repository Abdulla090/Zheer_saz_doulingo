# Gemini credentials and model routing belong only in Supabase Edge Functions;
# never use an EXPO_PUBLIC_* variable for a provider secret or model choice.

# Optional: hosted privacy policy URL for store listings
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-site.example.com/privacy
# EXPO_PUBLIC_SUPPORT_URL=https://your-site.example.com/support
# EXPO_PUBLIC_SUBSCRIPTION_URL=https://your-site.example.com/pricing

# Optional: Sentry crash reporting (https://sentry.io — create a React Native project)
# Set these in the EAS production environment. The production config refuses to
# build without all four so a release cannot ship without readable crash reports.
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-sentry-organization
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=sntrys_your_private_source_map_upload_token
# EXPO_PUBLIC_SENTRY_DEBUG=1

# Force JS floating tab bar on Android dev builds (Expo Go uses this automatically)
# EXPO_PUBLIC_ANDROID_JS_TABS=1

# Android dev client can't reach Metro? Use your PC's LAN IP (ipconfig) or tunnel:
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.19
# Then: npx expo start --dev-client --clear
# Or: npx expo start --tunnel
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase Edge Function secrets for checkout safety. Update the IQD/USD value
# from a verified operational source before activating any billing product.
# Checkout fails closed if this is missing or if the margin multiplier is < 3.
# AI_COST_SAFETY_IQD_PER_USD=verified-current-rate
# AI_COST_SAFETY_MULTIPLIER=3.1
