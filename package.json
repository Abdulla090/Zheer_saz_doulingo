{
  "name": "twino",
  "main": "index.js",
  "version": "1.0.0",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "start:go": "expo start --go",
    "start:go:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clear-metro-cache.ps1 && expo start --go --clear",
    "start:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clear-metro-cache.ps1 && expo start --clear",
    "start:dev": "expo start --dev-client",
    "start:dev:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clear-metro-cache.ps1 && expo start --dev-client --clear",
    "start:mcp": "node ./scripts/start-with-mcp.js",
    "start:emu": "powershell -ExecutionPolicy Bypass -File ./scripts/start-android-emulator.ps1",
    "start:emu:mcp": "powershell -ExecutionPolicy Bypass -File ./scripts/start-android-emulator.ps1 mcp",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "start:web:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clear-metro-cache.ps1 && expo start --web --clear",
    "web:mcp": "node ./scripts/start-with-mcp.js --web",
    "lint": "expo lint",
    "lint:strict": "expo lint --max-warnings=0",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "verify": "node scripts/verify-release.mjs",
    "eas-build-pre-install": "node scripts/eas-pre-install.mjs",
    "build:apk": "npx eas-cli build --platform android --profile preview --non-interactive"
  },
  "dependencies": {
    "@expo/ui": "~57.0.12",
