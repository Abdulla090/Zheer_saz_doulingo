{
  "expo": {
    "name": "TWINO",
    "slug": "twino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/real-app-icon.png",
    "scheme": "twino",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/real-app-icon.png",
      "bundleIdentifier": "com.hewad.mubariz.twino",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Twino English to transcribe your speech for lessons and AI feedback.",
        "NSMicrophoneUsageDescription": "Allow Twino English to use the microphone for speaking practice.",
        "NSPhotoLibraryUsageDescription": "Allow Twino to choose a profile photo from your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/real-app-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.hewad.mubariz.twino",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/real-app-icon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "hidden": true,
          "behavior": "inset-swipe",
          "enforceContrast": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usePrecompiledHeaders": true,
            "usesCleartextTraffic": false,
            "kotlinVersion": "2.1.20"
          },
          "ios": {
            "useHermesV1": true,
            "privacyManifestAggregationEnabled": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/real-app-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/real-app-icon.png",
            "imageWidth": 200
          },
          "ios": {
            "image": "./assets/images/real-app-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-font",
      "expo-image",
      "./plugins/with-speaking-audio-permission.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Twino to choose a profile photo from your photo library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Twino English to use the microphone for speaking practice.",
          "speechRecognitionPermission": "Allow Twino English to transcribe your speech for lessons and AI feedback."
        }
      ],
      "./plugins/with-normalize-android-receivers.js",
      "./plugins/with-align-workmanager.js",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.hewad.mubariz.twino",
          "widgets": [
            {
              "name": "TwinoHome",
              "displayName": "Twino",
              "description": "Streak, daily XP, path progress, and your next lesson",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.hewad.mubariz.twino.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.hewad.mubariz.twino"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "834d7db4-d690-4c90-8490-8b86ac3c6eb1"
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "hidden": true
      }
    },
    "owner": "abdulla001"
  }
}
